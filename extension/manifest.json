{
  "manifest_version": 3,
  "name": "ThemeAI — Pixel Studio",
  "version": "1.1.1",
  "description": "Pixel Night, Forest, Sakura và nền ảnh riêng cho ChatGPT, Codex, Claude. Đồ họa theo mẫu đã duyệt.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://codex.chatgpt.com/*",
        "https://codex.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "theme.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.webp"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://codex.chatgpt.com/*",
        "https://codex.com/*",
        "https://claude.ai/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
