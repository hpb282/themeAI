{
  "manifest_version": 3,
  "name": "ThemeAI — Pixel Studio",
  "version": "1.0.0",
  "description": "Pixel Night, Forest và Sakura cho ChatGPT, Codex và Claude. Cảnh động, sao, mây và tia sáng theo chuột.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://codex.chatgpt.com/*",
        "https://codex.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "theme.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
